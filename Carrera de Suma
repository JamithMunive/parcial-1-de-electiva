using System;

class Program
{
    static void Main()
    {
        int jugador1 = 0;
        int jugador2 = 0;
        int puntos1;
        int puntos2;
        int turnos = 0;

        while (jugador1 < 100 && jugador2 < 100)
        {
            Console.Write("Puntos del jugador 1: ");
            puntos1 = int.Parse(Console.ReadLine());

            Console.Write("Puntos del jugador 2: ");
            puntos2 = int.Parse(Console.ReadLine());

            jugador1 = jugador1 + puntos1;
            jugador2 = jugador2 + puntos2;

            turnos++;
        }

        Console.WriteLine();
        Console.WriteLine("Resultados:");

        if (jugador1 > jugador2)
        {
            Console.WriteLine("Ganó el jugador 1");
            Console.WriteLine("Puntaje del jugador 1: " + jugador1);
            Console.WriteLine("Puntaje del jugador 2: " + jugador2);
            Console.WriteLine("Ganó por " + (jugador1 - jugador2) + " puntos");
        }
        else
        {
            Console.WriteLine("Ganó el jugador 2");
            Console.WriteLine("Puntaje del jugador 1: " + jugador1);
            Console.WriteLine("Puntaje del jugador 2: " + jugador2);
            Console.WriteLine("Ganó por " + (jugador2 - jugador1) + " puntos");
        }

        Console.WriteLine("Turnos: " + turnos);
    }
}
