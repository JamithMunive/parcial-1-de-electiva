using System;

class Program
{
    static void Main()
    {
        int stock = 100;
        int venta;
        int dias = 0;
        int totalVendido = 0;
        int mayor = 0;
        int menor = 0;

        while (stock > 0)
        {
            Console.Write("Ingrese las unidades vendidas hoy: ");
            venta = int.Parse(Console.ReadLine());

            if (venta > stock)
            {
                Console.WriteLine("No puede vender más unidades de las disponibles.");
            }
            else
            {
                stock = stock - venta;
                totalVendido = totalVendido + venta;
                dias++;

                if (dias == 1)
                {
                    mayor = venta;
                    menor = venta;
                }
                else
                {
                    if (venta > mayor)
                    {
                        mayor = venta;
                    }

                    if (venta < menor)
                    {
                        menor = venta;
                    }
                }
            }
        }

        Console.WriteLine();
        Console.WriteLine("Resultados:");
        Console.WriteLine("Días que duró el stock: " + dias);

        if (dias > 0)
        {
            Console.WriteLine("Promedio de venta diaria: " + (totalVendido / (double)dias));
            Console.WriteLine("Máxima venta diaria: " + mayor);
            Console.WriteLine("Mínima venta diaria: " + menor);
        }
        else
        {
            Console.WriteLine("No se realizaron ventas.");
        }
    }
}
